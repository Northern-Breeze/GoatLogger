{
  "name": "goatlogger",
  "description": "Async, non-blocking logger SDK with remote ingest, automatic batching, exponential-backoff retry, and a dead-letter queue.",
  "version": "2.0.0",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./browser": {
      "types": "./lib/browser.d.ts",
      "import": "./lib/browser.mjs",
      "require": "./lib/browser.js"
    },
    "./node": {
      "types": "./lib/node.d.ts",
      "import": "./lib/node.mjs",
      "require": "./lib/node.js"
    }
  },
  "author": "Samuel Mothwa",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Northern-Breeze/GoatLogger"
  },
  "peerDependencies": {
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "prettier": "^3.3.2",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "ws": "^8.18.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "tslint -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build",
    "postversion": "git push && git push --tags"
  },
  "files": [
    "lib/**/*"
  ],
  "bugs": {
    "url": "https://github.com/Northern-Breeze/GoatLogger/issues"
  },
  "homepage": "https://github.com/Northern-Breeze/GoatLogger#readme"
}
